class ScannerStation extends Thread {

    private final int stationNumber;
    private final int scripts;

    ScannerStation(int stationNumber, int scripts) {
        this.stationNumber = stationNumber;
        this.scripts = scripts;
    }

    @Override
    public void run() {

        int scanned = 0;

        try {
            for (int i = 1; i <= scripts; i++) {
                Thread.sleep(100);
                scanned++;
            }

            System.out.println("Station " + stationNumber
                    + " scanned " + scanned + " scripts");

        } catch (InterruptedException e) {
            Thread.currentThread().interrupt();
        }
    }
}

class RunnableStation implements Runnable {

    private final int stationNumber;
    private final int scripts;

    RunnableStation(int stationNumber, int scripts) {
        this.stationNumber = stationNumber;
        this.scripts = scripts;
    }

    @Override
    public void run() {

        int scanned = 0;

        try {
            for (int i = 1; i <= scripts; i++) {
                Thread.sleep(100);
                scanned++;
            }

            System.out.println("Runnable Station " + stationNumber
                    + " scanned " + scanned + " scripts");

        } catch (InterruptedException e) {
            Thread.currentThread().interrupt();
        }
    }
}

public class ScannerStation {

    public static void main(String[] args)
            throws InterruptedException {

        Thread t1 = new ScannerStationThread(1, 5);
        Thread t2 = new ScannerStationThread(2, 5);

        Thread t3 = new Thread(new RunnableStation(3, 5));
        Thread t4 = new Thread(new RunnableStation(4, 5));

        t1.start();
        t2.start();
        t3.start();
        t4.start();

        System.out.println("Station 1 alive: " + t1.isAlive());

        t1.join();
        t2.join();
        t3.join();
        t4.join();

        System.out.println("All scanner stations completed");
    }
}

