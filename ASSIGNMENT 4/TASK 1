import java.awt.*;
import java.awt.event.*;
import javax.swing.*;

class FeeService {

    boolean pay(String regNo, double amount) {

        if (regNo.isEmpty() || amount <= 0) {
            return false;
        }

        return true;
    }
}

public class FeeWindow extends JFrame {

    JTextField regNo = new JTextField(15);
    JTextField amount = new JTextField(15);

    JButton pay = new JButton("Pay");
    JButton clear = new JButton("Clear");
    JButton receipt = new JButton("Receipt");

    FeeService service = new FeeService();

    FeeWindow() {

        setTitle("Student Fee Payment");
        setLayout(new GridLayout(4, 2, 10, 10));

        add(new JLabel("Register Number"));
        add(regNo);

        add(new JLabel("Amount"));
        add(amount);

        add(pay);
        add(clear);

        add(receipt);

        pay.addActionListener(e -> payment());
        clear.addActionListener(e -> clearFields());
        receipt.addActionListener(e -> showReceipt());

        setSize(400, 250);
        setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
        setLocationRelativeTo(null);
        setVisible(true);
    }

    void payment() {

        try {
            double a = Double.parseDouble(amount.getText());

            if (service.pay(regNo.getText(), a)) {
                JOptionPane.showMessageDialog(this, "Payment Successful");
            } else {
                JOptionPane.showMessageDialog(this, "Invalid Input");
            }

        } catch (NumberFormatException e) {
            JOptionPane.showMessageDialog(this, "Enter valid amount");
        }
    }

    void clearFields() {
        regNo.setText("");
        amount.setText("");
    }

    void showReceipt() {
        JOptionPane.showMessageDialog(this,
                "Register Number: " + regNo.getText()
                + "\nAmount: " + amount.getText());
    }

    public static void main(String[] args) {
        SwingUtilities.invokeLater(FeeWindow::new);
    }
}
